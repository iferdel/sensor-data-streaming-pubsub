          "rawQuery": true,
          "rawSql": "SELECT \n    time_bucket('10 seconds', time) as time,\n    '$serial_number' as metric,\n    COUNT(*) / 10.0 as value\nFROM sensor_measurement sm\nJOIN sensor s ON sm.sensor_id = s.id\nWHERE s.serial_number = '$serial_number'\n  AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
